---
import Layout from "@/layouts/main.astro"
import { CourseSchedule } from "@/components/course-schedule"
import HeroImage from "@/components/HeroImage.astro"
import { getScheduleEvents } from "@/lib/supabase"

const { data: scheduleEvents, error } = await getScheduleEvents()

if (!scheduleEvents || error) {
  throw new Error("Lỗi hiển thị sự kiện")
}

console.log(scheduleEvents)
---

<Layout>
  <section class="w-full overflow-hidden">
    <HeroImage>
      <!-- 4. Tiêu đề trung tâm với hiệu ứng Pixel Shadow -->
      <!-- Shadow -->
      <text
        x="964"
        y="204"
        text-anchor="middle"
        font-size="64"
        font-weight="900"
        fill="#3b82f6"
      >
        Lịch học PIXEL2027
      </text>
      <!-- Main Text -->
      <text
        x="960"
        y="200"
        text-anchor="middle"
        font-size="64"
        font-weight="900"
        fill="#ffffff"
      >
        Lịch học <tspan fill="#4ade80">PIXEL2027</tspan>
      </text>

      <!-- Subtitle -->
      <text
        x="960"
        y="280"
        text-anchor="middle"
        font-size="24"
        font-weight="bold"
        fill="#94a3b8"
        letter-spacing="2"
      >
        [ "Mistakes are proof that you are trying. "]
      </text>
    </HeroImage>
  </section>

  <CourseSchedule client:load scheduleEvents={scheduleEvents} />
</Layout>
