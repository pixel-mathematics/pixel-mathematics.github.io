---
import Layout from "@/layouts/main.astro"
import Container from "@/components/Container.astro"
import Hero from "@/components/Hero.astro"
import RecentLessonListItem from "@/components/RecentLessonListItem.astro"
import { MessageListItem } from "@/components/message-list-item"
import { getActiveMessages, getRecentLessonsWithinWeek } from "@/lib/supabase"
import type { RecentLesson, MessageWithCourse } from "@/types"

const { data: recentLessons, error: getRecentLessonsError } =
  await getRecentLessonsWithinWeek()

if (!recentLessons || getRecentLessonsError) {
  throw new Error("Lỗi hiển thị các bài học gần nhất")
}

const { data: messages, error: getMessagesError } = await getActiveMessages()

if (!messages || getMessagesError) {
  throw new Error("Lỗi hiển thị lời nhắn")
}
console.log(messages)
---

<Layout>
  <section class="w-full overflow-hidden">
    <Hero
      text="Pixel"
      highlightText="Mathematics"
      quote={`"The more I learn, the less I realize I know"`}
    />
  </section>
  <section class="mt-6">
    <Container>
      <h1 class="mb-4 text-2xl font-bold text-primary">Bài học gần đây</h1>
      <div class="grid grid-cols-1 gap-2">
        {
          recentLessons.map((lesson) => (
            <RecentLessonListItem lesson={lesson} />
          ))
        }
      </div>
    </Container>
  </section>
  <section class="my-6">
    <Container>
      <h1 class="mb-4 text-2xl font-bold text-primary">Lời nhắn</h1>
      <div class="grid grid-cols-1 gap-2">
        {
          messages.map((message: MessageWithCourse) => (
            <MessageListItem client:load key={message.id} message={message} />
          ))
        }
      </div>
    </Container>
  </section>
</Layout>
