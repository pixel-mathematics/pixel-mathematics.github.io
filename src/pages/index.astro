---
import Layout from "@/layouts/main.astro"
import Container from "@/components/Container.astro"
import HeroImage from "@/components/HeroImage.astro"
import RecentLessonListItem from "@/components/RecentLessonListItem.astro"
import MessageListItem from "@/components/MessageListItem.astro"
import { getActiveMessages, getRecentLessonsWithinWeek } from "@/lib/supabase"
import type { RecentLesson } from "@/types"

const { data: recentLessons, error: getRecentLessonsError } =
  await getRecentLessonsWithinWeek()

if (!recentLessons || getRecentLessonsError) {
  throw new Error("Lỗi hiển thị các bài học gần nhất")
}

const { data: messages, error: getMessagesError } = await getActiveMessages()

if (!messages || getMessagesError) {
  throw new Error("Lỗi hiển thị lời nhắn")
}
---

<Layout>
  <section class="w-full overflow-hidden">
    <HeroImage>
      <!-- 4. Tiêu đề trung tâm với hiệu ứng Pixel Shadow -->
      <!-- Shadow -->
      <text
        x="964"
        y="204"
        text-anchor="middle"
        font-size="64"
        font-weight="900"
        fill="#3b82f6"
      >
        Pixel Mathematics
      </text>
      <!-- Main Text -->
      <text
        x="960"
        y="200"
        text-anchor="middle"
        font-size="64"
        font-weight="900"
        fill="#ffffff"
      >
        Pixel <tspan fill="#4ade80">Mathematics</tspan>
      </text>

      <!-- Subtitle -->
      <text
        x="960"
        y="280"
        text-anchor="middle"
        font-size="24"
        font-weight="bold"
        fill="#94a3b8"
        letter-spacing="2"
      >
        [ "The more I learn, the less I realize I know" - Socrates ]
      </text>
    </HeroImage>
  </section>
  <section class="mt-6">
    <Container>
      <h1 class="mb-4 text-2xl font-bold text-primary">Bài học gần đây</h1>
      <div class="grid grid-cols-1 gap-2">
        {
          recentLessons.map((lesson: RecentLesson) => (
            <RecentLessonListItem {...lesson} />
          ))
        }
      </div>
    </Container>
  </section>
  <section class="mt-6">
    <Container>
      <h1 class="mb-4 text-2xl font-bold text-primary">Lời nhắn</h1>
      <div class="grid grid-cols-1 gap-2">
        {messages.map((message: any) => <MessageListItem {...message} />)}
      </div>
    </Container>
  </section>
</Layout>
