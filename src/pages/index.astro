---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import HeroImage from "@/components/HeroImage.astro"
import { createServerClient } from "@/lib/supabase"

const supabase = createServerClient()
const { data: courses, error } = await supabase.from("courses").select()
---

<Layout>
  <section class="w-full overflow-hidden">
    <HeroImage>
      <!-- 4. Tiêu đề trung tâm với hiệu ứng Pixel Shadow -->
      <!-- Shadow -->
      <text
        x="964"
        y="204"
        text-anchor="middle"
        font-size="80"
        font-weight="900"
        fill="#3b82f6"
      >
        Pixel Mathematics
      </text>
      <!-- Main Text -->
      <text
        x="960"
        y="200"
        text-anchor="middle"
        font-size="80"
        font-weight="900"
        fill="#ffffff"
      >
        Pixel <tspan fill="#4ade80">Mathematics</tspan>
      </text>

      <!-- Subtitle -->
      <text
        x="960"
        y="280"
        text-anchor="middle"
        font-size="24"
        font-weight="bold"
        fill="#94a3b8"
        letter-spacing="2"
      >
        [ "The more I learn, the less I realize I know" - Socrates ]
      </text>
    </HeroImage>
  </section>
</Layout>
