---
import { createServerClient } from "@/lib/supabase"

import Layout from "@/layouts/main.astro"
import HeroImage from "@/components/HeroImage.astro"
import Container from "@/components/Container.astro"
import { CourseOutline } from "@/components/course-outline"

export async function getStaticPaths() {
  const supabase = createServerClient()
  const { data: courses, error } = await supabase.from("courses").select(`id`)
  if (!courses || error) {
    throw new Error("Lỗi lấy dữ liệu khóa học")
  }
  return courses.map((course: any) => ({ params: { id: course.id } }))
}

const supabase = createServerClient()
const { data: course, error } = await supabase
  .from("courses")
  .select(
    `
    id,
    title,
    description,
    start_date,
    updated_at,
    status,
    chapters (
      id,
      title,
      sort_order,
      lessons (
        id,
        title,
        class_date,
        updated_at,
        due_date,
        sort_order,
        lesson_attachments (
          id,
          file_name,
          file_url,
          file_type
        )
      )
    )
`
  )
  .order("id", { referencedTable: "chapters", ascending: true })
  .eq("id", Astro.params.id)
  .single()

if (!course || error) {
  throw new Error("Lỗi lấy dữ liệu khóa học")
}

const { id, title, description, start_date, updated_at, chapters } = course
---

<Layout>
  <section class="w-full overflow-hidden">
    <HeroImage>
      <!-- 4. Tiêu đề trung tâm với hiệu ứng Pixel Shadow -->
      <!-- Shadow -->
      <text
        x="964"
        y="204"
        text-anchor="middle"
        font-size="80"
        font-weight="900"
        fill="#3b82f6"
      >
        Khóa {title}
      </text>
      <!-- Main Text -->
      <text
        x="960"
        y="200"
        text-anchor="middle"
        font-size="80"
        font-weight="900"
        fill="#ffffff"
      >
        Khóa <tspan fill="#4ade80">{title}</tspan>
      </text>

      <!-- Subtitle -->
      <text
        x="960"
        y="280"
        text-anchor="middle"
        font-size="24"
        font-weight="bold"
        fill="#94a3b8"
        letter-spacing="2"
      >
        [ {description} ]
      </text>
    </HeroImage>
  </section>
  <section>
    <div class="flex min-h-svh p-6">
      <Container>
        <CourseOutline client:load chapters={chapters} />
      </Container>
    </div>
  </section>
</Layout>
