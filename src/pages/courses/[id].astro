---
import { getCourses, getCourseById } from "@/lib/supabase"

import Layout from "@/layouts/main.astro"
import HeroImage from "@/components/HeroImage.astro"
import Container from "@/components/Container.astro"
import { CourseOutline } from "@/components/course-outline"

export const prerender = false

export async function getStaticPaths() {
  const { data: courses, error } = await getCourses()
  if (!courses || error) {
    throw new Error("Lỗi lấy dữ liệu khóa học")
  }
  return courses.map((course: any) => ({ params: { id: course.id } }))
}

const { data: course, error } = await getCourseById(Astro.params.id)

if (!course || error) {
  throw new Error("Lỗi lấy dữ liệu khóa học")
}

const { id, title, description, start_date, updated_at, chapters } = course

const chapter_id = Astro.url.searchParams.get("chapter_id")
const lesson_id = Astro.url.searchParams.get("lesson_id")
console.log(Astro.url)
---

<Layout>
  <section class="w-full overflow-hidden">
    <HeroImage>
      <!-- 4. Tiêu đề trung tâm với hiệu ứng Pixel Shadow -->
      <!-- Shadow -->
      <text
        x="964"
        y="204"
        text-anchor="middle"
        font-size="64"
        font-weight="900"
        fill="#3b82f6"
      >
        Khóa {title}
      </text>
      <!-- Main Text -->
      <text
        x="960"
        y="200"
        text-anchor="middle"
        font-size="64"
        font-weight="900"
        fill="#ffffff"
      >
        Khóa <tspan fill="#4ade80">{title}</tspan>
      </text>

      <!-- Subtitle -->
      <text
        x="960"
        y="280"
        text-anchor="middle"
        font-size="24"
        font-weight="bold"
        fill="#94a3b8"
        letter-spacing="2"
      >
        [ {description} ]
      </text>
    </HeroImage>
  </section>
  <section>
    <div class="flex min-h-svh p-6">
      <Container>
        <CourseOutline
          client:load
          course={course}
          chapter_id={chapter_id}
          lesson_id={lesson_id}
        />
      </Container>
    </div>
  </section>
</Layout>
