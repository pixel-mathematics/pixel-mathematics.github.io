---
import Layout from "@/layouts/main.astro"
import SubjectCard from "@/components/SubjectCard.astro"
import CourseCard from "@/components/CourseCard.astro"
import Container from "@/components/Container.astro"
import HeroImage from "@/components/HeroImage.astro"
import { Separator } from "@/components/ui/separator"
import { getSubjects, getCourses } from "@/lib/supabase"

const { data: subjects, error: getSubjectsError } = await getSubjects()

if (!subjects || getSubjectsError) {
  throw new Error("Lỗi không thể hiển thị khóa học")
}

const { data: courses, error: getCoursesError } = await getCourses()

if (!courses || getCoursesError) {
  throw new Error("Lỗi không thể hiển thị khóa học")
}
---

<Layout>
  <section class="w-full overflow-hidden">
    <HeroImage>
      <!-- 4. Tiêu đề trung tâm với hiệu ứng Pixel Shadow -->
      <!-- Shadow -->
      <text
        x="964"
        y="204"
        text-anchor="middle"
        font-size="64"
        font-weight="900"
        fill="#3b82f6"
      >
        Khóa học PIXEL2027
      </text>
      <!-- Main Text -->
      <text
        x="960"
        y="200"
        text-anchor="middle"
        font-size="64"
        font-weight="900"
        fill="#ffffff"
      >
        Khóa học <tspan fill="#4ade80">PIXEL2027</tspan>
      </text>

      <!-- Subtitle -->
      <text
        x="960"
        y="280"
        text-anchor="middle"
        font-size="24"
        font-weight="bold"
        fill="#94a3b8"
        letter-spacing="2"
      >
        [ "Mistakes are proof that you are trying. "]
      </text>
    </HeroImage>
  </section>

  <section>
    <div class="flex min-h-svh p-6">
      <Container>
        <div class="pb-4">
          <h1 class="mb-4 text-2xl font-bold text-primary">
            Danh sách môn học
          </h1>
          <div class="grid grid-cols-3 gap-4">
            {subjects.map((subject: any) => <SubjectCard {...subject} />)}
          </div>
        </div>
        <Separator />
        <div class="py-4">
          <h1 class="mb-4 text-2xl font-bold text-primary">Toàn bộ khóa học</h1>
          <div class="grid grid-cols-2 gap-4">
            {courses.map((course: any) => <CourseCard {...course} />)}
          </div>
        </div>
      </Container>
    </div>
  </section>
</Layout>
