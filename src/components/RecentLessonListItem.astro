---
import { formatDate } from "@/lib/utils"
import { ClockIcon, KeyRoundIcon, ScrollTextIcon } from "lucide-react"
import type { RecentLesson } from "@/types"
interface Props {
  lesson: RecentLesson
}

const { id, title, updated_at, chapters } = Astro.props.lesson
---

<a
  href={`/courses/${chapters.courses.id}?chapter_id=${chapters.id}&lesson_id=${id}`}
>
  <div
    class="flex flex-col items-start gap-2 rounded-md border px-3 py-2.5 text-base md:flex-row md:items-center"
  >
    <div
      class="flex flex-col items-start gap-2 font-medium md:flex-row md:items-center"
    >
      <span
        class="flex h-6 w-20 items-center justify-center rounded-sm bg-primary/10 text-sm font-semibold text-nowrap text-primary uppercase"
      >
        {id}
      </span>
      <span class="max-w-[80vw] truncate text-nowrap md:max-w-full"
        >{title}</span
      >
    </div>
    <div class="ml-auto grid grid-cols-3 text-sm">
      <div class="flex items-center gap-1 font-medium text-primary uppercase">
        <KeyRoundIcon size={14} />{chapters.courses.id}
      </div>
      <div class="flex items-center gap-1 font-medium text-pink-700 uppercase">
        <ScrollTextIcon size={14} />{chapters.id}
      </div>
      <div class="flex items-center gap-1 text-foreground/60">
        <ClockIcon size={14} />
        <span>
          {formatDate(updated_at)}
        </span>
      </div>
    </div>
  </div>
</a>
