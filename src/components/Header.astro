---
import Container from "@/components/Container.astro"
import Logo from "@/components/Logo.astro"
import Navigation from "@/components/Navigation.astro"
import { MobileNavigation } from "@/components/mobile-navigation"
import { Search } from "@/components/search"
import { getLessons } from "@/lib/supabase"

const { data: lessons, error: getLessonsError } = await getLessons()
if (!lessons || getLessonsError) {
  throw new Error("Lỗi lấy dữ liệu khóa học")
}
---

<header class="sticky top-0 z-10 bg-background shadow-lg">
  <Container class="flex h-16 items-center justify-between">
    <a href="/">
      <div class="flex items-center gap-2">
        <Logo class="h-8 w-8" />
        <div class="hidden text-2xl font-bold md:block">Pixel Mathematics</div>
      </div>
    </a>
    <div class="flex flex-row-reverse items-center gap-2 md:flex-row">
      <div class="hidden md:block">
        <Navigation />
      </div>
      <div class="flex md:hidden">
        <MobileNavigation client:load />
      </div>
      <Search client:load data={{ lessons }} />
    </div>
  </Container>
</header>
