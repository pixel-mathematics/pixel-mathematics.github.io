---
import { KeyRoundIcon, BookIcon, ClockIcon } from "lucide-react"
import { formatDate } from "@/lib/utils"
import {
  Card,
  CardHeader,
  CardFooter,
  CardTitle,
  CardDescription,
} from "./ui/card"
import type { CourseWithSubject } from "@/types"

interface Props extends CourseWithSubject {}

const { id, subjects, title, description, updated_on } = Astro.props
---

<a href={`/courses/${id}`}>
  <Card
    className="group border-1 border-primary/0 duration-300 hover:border-primary"
  >
    <CardHeader>
      <CardTitle
        className="text-lg font-semibold uppercase duration-300 group-hover:text-primary"
        >{title}</CardTitle
      >
      <CardDescription className="truncate">{description}</CardDescription>
    </CardHeader>
    <CardFooter>
      <div class="flex w-full items-center gap-4">
        <div
          class="flex items-center gap-1 font-semibold text-primary uppercase"
        >
          <KeyRoundIcon size={16} />{id}
        </div>
        <div class="flex items-center gap-1 font-semibold">
          <BookIcon size={16} />{subjects.title}
        </div>
        <div class="ml-auto flex items-center gap-1">
          <ClockIcon size={16} />
          {formatDate(updated_on)}
        </div>
      </div>
    </CardFooter>
  </Card>
</a>
