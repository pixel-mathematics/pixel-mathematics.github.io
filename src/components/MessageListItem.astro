---
import { formatDate } from "@/lib/utils"
import { KeyRoundIcon, ClockIcon } from "lucide-react"

interface Props {
  id: string
  content: string
  created_at: Date
  courses: {
    id: string
    title: string
  }
}

const { id, content, created_at, courses } = Astro.props
---

<div class="flex items-center gap-2 rounded-md border px-3 py-2.5 text-base">
  <div class="flex items-center gap-1 font-medium text-primary uppercase">
    <KeyRoundIcon size={16} />{courses.id}
  </div>
  <div class="flex items-center gap-2">
    <span>{content}</span>
  </div>
  <div class="ml-auto flex items-center gap-4 text-sm">
    <div class="flex items-center gap-1 text-foreground/60">
      <ClockIcon size={16} />
      <span>
        {formatDate(created_at)}
      </span>
    </div>
  </div>
</div>
