---

---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1920 400"
  width="100%"
  height="100%"
  style="background-color: #0f172a; font-family: 'Courier New', Courier, monospace;"
>
  <!-- 1. Pixel Grid Background -->
  <defs>
    <pattern
      id="pixelGrid"
      width="20"
      height="20"
      patternUnits="userSpaceOnUse"
    >
      <rect width="20" height="20" fill="none" stroke="#1e293b" stroke-width="2"
      ></rect>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#pixelGrid)"></rect>

  <!-- 2. Ký hiệu và Công thức Toán học (Trang trí xung quanh) -->
  <g font-weight="bold" opacity="0.3" shape-rendering="crispEdges">
    <!-- Cụm bên trái -->
    <text x="50" y="80" font-size="48" fill="#4ade80">∑</text>
    <text x="300" y="320" font-size="80" fill="#38bdf8">π</text>
    <text x="80" y="220" font-size="32" fill="#a78bfa">y=mx+b</text>
    <text x="450" y="80" font-size="36" fill="#f472b6">a² + b² = c²</text>

    <!-- Cụm bên phải -->
    <text x="1600" y="160" font-size="64" fill="#f472b6">√x</text>
    <text x="1450" y="270" font-size="80" fill="#f87171">∞</text>
    <text x="1750" y="240" font-size="40" fill="#fbbf24">E=mc²</text>
    <text x="1300" y="90" font-size="56" fill="#2dd4bf">∫</text>
    <text x="1800" y="80" font-size="48" fill="#ffffff">+</text>
    <text x="1250" y="340" font-size="48" fill="#ffffff">÷</text>
  </g>

  <!-- 3. Các khối vuông trang trí chuẩn Pixel -->
  <g shape-rendering="crispEdges">
    <rect x="200" y="40" width="20" height="20" fill="#4ade80"></rect>
    <rect x="220" y="80" width="20" height="20" fill="#38bdf8"></rect>
    <rect x="1700" y="300" width="20" height="20" fill="#f87171"></rect>
    <rect x="1680" y="280" width="20" height="20" fill="#fbbf24"></rect>
    <rect x="800" y="350" width="20" height="20" fill="#a78bfa"></rect>
    <rect x="1100" y="50" width="20" height="20" fill="#2dd4bf"></rect>
  </g>

  <slot />
</svg>
